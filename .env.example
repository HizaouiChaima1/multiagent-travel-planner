# Copier ce fichier en .env (non versionné) : cp .env.example .env

# Agents (Mistral). Laisser vide et mettre PLANNER_MOCK=1 pour une démo sans clé.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# 1 = agents déterministes sans appel au LLM (démo, tests)
PLANNER_MOCK=0

# Authentification (JWT). À changer en dehors du développement local.
JWT_SECRET=change-me-dev-secret-at-least-32-bytes

# PostgreSQL
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel
POSTGRES_DB=travel

# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173

# URL de l'API vue par le navigateur
VITE_API_URL=http://localhost:8000
